# Database
DATABASE_URL=postgres://user:pass@localhost:5432/kunuz

# Enable checkout only after catalog + payment are approved
CATALOG_APPROVED=false
CHECKOUT_ENABLED=false

# Customer WhatsApp for orders while e-payment is being set up (Saudi: 9665XXXXXXXX)
CONTACT_WHATSAPP=201055782314

# Optional manual payment
MANUAL_PAYMENT_ENABLED=false
COD_ENABLED=false

# Admin panel at /admin (first-run password; change it inside the panel)
ADMIN_PASSWORD=
# Where admin edits + uploaded images are stored (use a persistent disk in production)
DATA_DIR=./data
ADMIN_USERNAME=admin

# Public address of the live site, e.g. https://shop.example.com
PUBLIC_URL=
# PostgreSQL connection string (in-site checkout, online payment, orders tab)
DATABASE_URL=
# Optional Moyasar secret key (otherwise set it in the admin panel)
MOYASAR_SECRET_KEY=
