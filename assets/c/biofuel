 msgModal(LM('t'),`${to?`<p style="margin:0">${LM('sentToE')} <b dir="ltr" style="unicode-bidi:isolate">${esc(to)}</b></p><p class="muted" style="margin:0;font-size:12.5px">${LM('spam')}</p>`:`<p style="margin:0">${LM('sentTo')} <b class="num">${esc(mobile)}</b></p>`}<form id="lgcode" data-m="${esc(mobile)}" style="display:grid;gap:10px" novalidate><label class="field">${LM('code')}<input id="lg-c" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" dir="ltr" style="text-align:center;font-size:26px;letter-spacing:10px;font-variant-numeric:tabular-nums"></label><p id="lg-err" style="color:var(--sale);margin:0;font-size:13px" hidden></p><button class="btn" type="submit">${LM('verify')}</button><div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:13.5px"><button type="button" class="link" id="lg-re" data-act="lgresend" data-m="${esc(mobile)}" data-e="${esc(email||'')}" disabled></button><button type="button" class="link" data-act="lgchange" data-m="${esc(mobile)}" data-e="${esc(email||'')}">${LM('change')}</button></div></form>`);
 let left=resendIn||60;const re=document.getElementById('lg-re');
 const tick=()=>{if(!document.getElementById('lg-re'))return clearInterval(loginTimer);if(left>0){re.disabled=true;re.textContent=`${LM('resendIn')} ${left}${LM('sec')}`;left--;}else{re.disabled=false;re.textContent=LM('resend');clearInterval(loginTimer);}};tick();loginTimer=setInterval(tick,1000);
 const ci=document.getElementById('lg-c');setTimeout(()=>ci&&ci.focus(),50);
 ci.addEventListener('input',()=>{ci.value=ci.value.replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/\D/g,'').slice(0,6);if(ci.value.length===6)document.getElementById('lgcode').requestSubmit();});
 if('OTPCredential' in window){otpAbort=new AbortController();navigator.credentials.get({otp:{transport:['sms']},signal:otpAbort.signal}).then(o=>{if(o&&o.code&&document.getElementById('lg-c')){ci.value=o.code;document.getElementById('lgcode').requestSubmit();}}).catch(()=>{});}
}
async function loginSend(mobile,btn,email){
 const err=document.getElementById('lg-err');if(btn){btn.disabled=true;}
 const {ok,d}=await api('/api/auth/send',{mobile,email:email||'',lang:S.lang});
 if(btn)btn.disabled=false;
 if(ok){if(d.channel)S.loginCh=d.channel;loginModal('code',d.mobile,d.resendIn,d.to,email);return;}
 if(d.error==='email_required'&&!document.getElementById('lg-e')){S.loginCh='email';loginModal('mobile',mobile);const e2=document.getElementById('lg-err');if(e2){e2.textContent=LE(d);e2.hidden=false;}return;}
 if(d.error==='wait'&&document.getElementById('lgcode'))return;
 if(err){err.textContent=LE(d);err.hidden=false;}
}
function viewAccount(){
 if(!S.user)return `<div class="panel empty"><h2 style="font-size:20px">${LM('t')}</h2><p class="muted">${LP()}</p><button class="btn" data-act="signin">${LM('t')}</button></div>`;
 const st=T[S.lang].stName;const O=S.myOrders;
 return `<nav class="crumbs"><button data-act="home">${t('home')}</button><span>›</span><span>${LM('acc')}</span></nav>
 <div class="co"><section style="display:grid;gap:14px"><div class="panel step"><h3 style="font-size:18px">${LM('orders')}</h3>
  ${O==null?`<p class="muted" style="margin:0">…</p>`:O.length?`<div style="display:grid;gap:8px">${O.map(o=>`<button class="optc" data-act="myorder" data-no="${esc(o.no)}" data-t="${esc(o.t)}" style="text-align:start;cursor:pointer"><span class="grow"><b class="num">${esc(o.no)}</b><div class="sub">${esc(S.lang==='ar'?o.first.ar:o.first.en)}${o.items>1?` +${o.items-1}`:''} · ${new Date(o.created_at).toLocaleDateString(S.lang==='ar'?'ar-u-ca-gregory-nu-latn':'en-GB')}</div></span><span style="display:grid;justify-items:end;gap:4px"><b>${money(o.total)}</b><span class="chip">${esc(st[o.status]||o.status)}</span></span></button>`).join('')}</div>`:`<p class="muted" style="margin:0">${LM('noOrders')}</p>`}
 </div></section>
 <aside class="panel step"><h3 style="font-size:18px">${LM('acc')}</h3><div class="sum"><div><span>${t('mobile')}</span><b class="num">${esc(S.user.mobile)}</b></div></div>
  <form id="nmform" style="display:grid;gap:8px"><label class="field">${LM('name')}<input id="ac-name" value="${esc(S.user.name||'')}" autocomplete="name" maxlength="80"></label><button class="btn ghost" type="submit">${LM('save')}</button></form>
  <button class="btn dark" data-act="logout">${LM('logout')}</button></aside></div>`;
}
function askName(){msgModal(AR()?'أهلاً بك في سمارت لاين':'Welcome to Smart Line',`<p class="muted" style="margin:0">${AR()?'اكتب اسمك عشان نظهره في حسابك وفواتيرك.':'Tell us your name for your account and invoices.'}</p><form id="nmask" style="display:grid;gap:10px"><label class="field">${LM('name')}<input id="nm-ask" autocomplete="name" maxlength="80" required></label><button class="btn" type="submit">${LM('save')}</button></form>`);setTimeout(()=>{const i=document.getElementById('nm-ask');if(i)i.focus();},60);}
async function loadMyOrders(){const {ok,d}=await api('/api/auth/orders');S.myOrders=ok?d:[];if(S.view==='account')renderView();}
/* ---------- installable app ---------- */
let instEvt=null;
const isStandalone=()=>matchMedia('(display-mode: standalone)').matches||navigator.standalone===true;
const isIOS=/iphone|ipad|ipod/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
const isMobileDev=/android|iphone|ipad|ipod|mobile|silk|opera mini/i.test(navigator.userAgent)||isIOS;
const instDismissed=()=>{try{return Date.now()-(+localStorage.getItem('sl-inst-x')||0)<3*864e5}catch(e){return false}};
function hideInstall(){const b=document.getElementById('instbar');if(b)b.remove();}
function showInstall(){
 if(isStandalone()||!isMobileDev||instDismissed()||document.getElementById('instbar'))return;
 const ar=S.lang==='ar';const d=document.createElement('div');d.id='instbar';d.className='instbar';d.setAttribute('role','dialog');
 d.innerHTML=`<img src="/icon-192.png" alt=""><div class="tx"><b>${ar?'حمّل تطبيق سمارت لاين':'Get the Smart Line app'}</b><span>${ar?'تصفّح أسرع وتابع طلباتك من شاشتك الرئيسية':'Faster browsing and order tracking from your home screen'}</span></div><button class="btn alt" data-act="install">${ar?'تثبيت':'Install'}</button><button class="x" data-act="instx" aria-label="${ar?'إغلاق':'Close'}">×</button>`;
 document.body.appendChild(d);
}
function installSteps(){
 const ar=S.lang==='ar';const share='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 8l5-5 5 5"/><path d="M5 12v8h14v-8"/></svg>';const dots='<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>';
 const st=isIOS?(ar?[`افتح المتجر في متصفح <b>Safari</b>`,`اضغط زر المشاركة ${share} أسفل الشاشة`,`اختر <b>إضافة إلى الشاشة الرئيسية</b>`,`اضغط <b>إضافة</b> — هيظهر تطبيق سمارت لاين بأيقونة الشركة`]:[`Open the store in <b>Safari</b>`,`Tap the Share button ${share}`,`Choose <b>Add to Home Screen</b>`,`Tap <b>Add</b> — the Smart Line app appears with the company icon`])
  :(ar?[`اضغط قائمة المتصفح ${dots} أعلى الشاشة`,`اختر <b>تثبيت التطبيق</b> أو <b>إضافة إلى الشاشة الرئيسية</b>`,`اضغط <b>تثبيت</b> — هيظهر تطبيق سمارت لاين بأيقونة الشركة`]:[`Open the browser menu ${dots}`,`Choose <b>Install app</b> or <b>Add to Home screen</b>`,`Tap <b>Install</b> — the Smart Line app appears with the company icon`]);
 msgModal(ar?'تثبيت تطبيق سمارت لاين':'Install the Smart Line app',`<ol class="isteps">${st.map(x=>`<li>${x}</li>`).join('')}</ol><button class="btn" data-act="close" style="width:max-content">${ar?'تمام':'OK'}</button>`);
}
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();instEvt=e;showInstall();});
window.addEventListener('appinstalled',()=>{instEvt=null;hideInstall();});
document.addEventListener('click',async e=>{const b=e.target.closest('[data-act=install],[data-act=instx]');if(!b)return;
 if(b.dataset.act==='instx'){try{localStorage.setItem('sl-inst-x',String(Date.now()))}catch(x){}hideInstall();return;}
 if(instEvt){instEvt.prompt();try{await instEvt.userChoice}catch(x){}instEvt=null;hideInstall();}else installSteps();});
setTimeout(showInstall,2500);
if('serviceWorker' in navigator&&location.protocol==='https:')window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));
applyUrl(true);renderHeader();renderMega();renderTabbar();renderView();if(S.view==='account'&&typeof loadMyOrders==='function')setTimeout(()=>{if(S.user)loadMyOrders();},800);loadOrderFromUrl();loadMe();
})();
