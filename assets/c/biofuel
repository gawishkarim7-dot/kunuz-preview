/* ---------- pricing ---------- */
function mult(p,sel){let m=1;(OPTS[p.cat]||[]).forEach(o=>{const i=(sel&&sel[o.k])||0;m*=o.v[i][2];});return m;}
function unitPrice(p,sel){return Math.round(p.price*mult(p,sel)*100)/100;}
function cfgQty(p,c){if(p.type!=='custom')return null;if(p.unit==='m2')return Math.max(.1,Math.round((c.w*c.h/10000)*100)/100);if(p.unit==='m')return Math.max(.5,+c.len||1);return null;}
function lineTotal(l){return Math.round(l.unit*l.qty*100)/100;}
function totals(){
 const items=S.cart.map(l=>({l,p:P.find(p=>p.id===l.id)}));
 const ready=items.filter(x=>x.p.type==='ready').reduce((a,x)=>a+lineTotal(x.l),0);
 const custom=items.filter(x=>x.p.type!=='ready').reduce((a,x)=>a+lineTotal(x.l),0);
 const sub=ready+custom;
 let ship=0;if(S.ship==='std')ship=sub>=500?0:25;if(S.ship==='exp')ship=45;if(S.ship==='ins')ship=150;if(S.ship==='pick')ship=0;
 const total=sub+ship;const vat=total*15/115;const now=total-custom*0.5;
 return {sub,ship,total,vat,now,custom,hasCustom:custom>0,count:S.cart.reduce((a,l)=>a+(Number.isInteger(l.qty)?l.qty:1),0)};
}

/* ---------- search ---------- */
const norm=s=>(s||'').toLowerCase().replace(/[إأآا]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/[ً-ْـ]/g,'').replace(/[()–\-]/g,' ');
function search(q,scope){const n=norm(q).trim();if(!n)return [];const toks=n.split(/\s+/);
 return P.filter(p=>{if(scope&&scope!=='all'&&catOf(p.cat).p!==scope)return false;const hay=norm(p.ar+' '+p.en+' '+p.kw+' '+p.sku+' '+catOf(p.cat).ar+' '+catOf(p.cat).en);return toks.every(tk=>hay.includes(tk));});}

