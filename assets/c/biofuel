function readUrl(){let r=location.pathname;if(/^#\/[a-z]/.test(location.hash||'')){r=location.hash.slice(1);history.replaceState(null,'',r);}
 const m=r.match(/^\/([a-z]+)(?:\/(.+))?$/);if(!m)return ['home',{q:'',cat:null,parent:null,coll:null}];
 const v=m[2]?decodeURIComponent(m[2]):'';const L=o=>['list',Object.assign({q:'',cat:null,parent:null,coll:null},o)];
 switch(m[1]){case 'p':{const id=+v;return P.find(x=>x.id===id)?['product',prodState(id)]:['home',{}];}
  case 'c':return L({cat:v});case 'd':return L({parent:v});case 'k':return L({coll:v});case 's':return L({q:v});case 'all':return L({});
  case 'checkout':return S.cart.length?['checkout',{}]:['home',{}];case 'account':return ['account',{}];}
 return ['home',{}];}
