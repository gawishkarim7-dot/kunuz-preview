 if(S.view==='product'&&S.pid!=null)return '/p/'+S.pid;
 if(S.view==='list')return S.q?'/s/'+e(S.q):S.cat?'/c/'+e(S.cat):S.parent?'/d/'+e(S.parent):S.coll?'/k/'+e(S.coll):'/all';
