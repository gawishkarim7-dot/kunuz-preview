function addToCart(p,qty,sel,cfg){
 const up=unitPrice(p,sel);const ins=p.type==='custom'&&cfg&&cfg.ins;
 const unit=Math.round(up*(ins?1.12:1)*100)/100;
 const opts=OPTS[p.cat]||[];
 let desc=opts.map(o=>S.lang==='ar'?o.v[(sel||{})[o.k]||0][0]:o.v[(sel||{})[o.k]||0][1]).join(' · ');
 if(p.type==='custom'&&p.unit==='m2')desc+=(desc?' · ':'')+`${cfg.w}×${cfg.h} cm`;
 if(ins)desc+=(desc?' · ':'')+(S.lang==='ar'?'مع التركيب':'with installation');
 const key=p.id+'|'+desc;
 const ex=S.cart.find(l=>l.key===key&&Number.isInteger(l.qty)&&Number.isInteger(qty));
 if(ex)ex.qty+=qty;else S.cart.push({key,id:p.id,qty,unit,desc,sel:Object.assign({},sel||{}),cfg:cfg&&p.type==='custom'?Object.assign({},cfg):null});
