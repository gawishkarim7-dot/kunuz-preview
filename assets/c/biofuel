async function placeOrder(){
 const need=['co-name','co-mob','co-dist'];let ok=true;
 need.forEach(id=>{const i=document.getElementById(id);if(!i.value.trim()){ok=false;i.style.borderColor='var(--sale)';}else i.style.borderColor='';});
 const mob=document.getElementById('co-mob');if(!/^(\+?966|0)?5\d{8}$/.test(mob.value.replace(/[\s-]/g,''))){ok=false;mob.style.borderColor='var(--sale)';}
 const terms=document.getElementById('co-terms').checked;if(!terms)ok=false;
 const err=document.getElementById('co-err');if(!ok){err.textContent=t('req');err.hidden=false;return;}
 const v=id=>{const el=document.getElementById(id);return el?el.value.trim():'';};
 const body={lang:S.lang,ship:S.ship,pay:S.pay,terms:true,
  customer:{name:v('co-name'),mobile:v('co-mob'),email:v('co-mail'),city:v('co-city'),district:v('co-dist'),nat:v('co-nat'),b2b:S.b2b,company:v('co-co'),vat:v('co-vat'),cr:v('co-cr')},
  lines:S.cart.map(l=>({id:l.id,qty:l.qty,sel:l.sel||{},cfg:l.cfg||null}))};
 const btn=document.querySelector('[data-act=place]');btn.disabled=true;btn.textContent='…';
 try{
  const r=await fetch('/api/orders',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  const d=await r.json();
  if(!r.ok){err.textContent=T[S.lang].errs[d.error]||T[S.lang].errs.generic;err.hidden=false;btn.disabled=false;btn.textContent=t('place');return;}
  try{localStorage.setItem('sl-last',JSON.stringify({no:d.orderNo,t:d.token}))}catch(x){}
  S.cart=[];S.terms=false;save();updateCount();
  if(d.redirect){location.href=d.redirect;return;}
  S.order=d.order;go('success');
 }catch(x){err.textContent=T[S.lang].errs.generic;err.hidden=false;btn.disabled=false;btn.textContent=t('place');}
}
