<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8">

<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>طاقة حيوية — منتجات خشبية | متجر سمارت لاين</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Readex+Pro:wght@500;600;700&display=swap">
<style>
/* Layout: marketplace shell — sticky steel header, category nav, dense product grid; palette = galvanized steel + walnut */
:root{
  --bg:#f5f0e8; --surface:#fffdf9; --surface-2:#f2eadf; --fg:#2a1c15; --muted:#6d5c50; --line:#e4d8c8;
  --steel:#2b1d16; --steel-2:#1e130e; --steel-fg:#f4ebe1; --wood:#b26b2b; --wood-strong:#8f5320; --wood-soft:#f4e3cf;
  --ok:#2c7a4b; --warn:#a4561b; --sale:#b3261e; --focus:#c47a35;
  --art-metal:#e7e3de; --art-wood:#f0e3d2;
  --f-display:"Readex Pro","IBM Plex Sans Arabic",system-ui,sans-serif;
  --f-body:"IBM Plex Sans Arabic","Segoe UI",Tahoma,system-ui,sans-serif;
  --r:8px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#160f0b; --surface:#211710; --surface-2:#2a1d15; --fg:#f2e9df; --muted:#b5a395; --line:#3b2c21;
  --steel:#110a07; --steel-2:#0b0604; --steel-fg:#f2e7db; --wood:#d58b47; --wood-strong:#e8a465; --wood-soft:#3b2717;
  --ok:#5cc28c; --warn:#e8975a; --sale:#f0726a; --focus:#e8a465; --art-metal:#2b2724; --art-wood:#34271c; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#160f0b; --surface:#211710; --surface-2:#2a1d15; --fg:#f2e9df; --muted:#b5a395; --line:#3b2c21;
  --steel:#110a07; --steel-2:#0b0604; --steel-fg:#f2e7db; --wood:#d58b47; --wood-strong:#e8a465; --wood-soft:#3b2717;
  --ok:#5cc28c; --warn:#e8975a; --sale:#f0726a; --focus:#e8a465; --art-metal:#2b2724; --art-wood:#34271c; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--f-body);font-size:15px;line-height:1.55}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--steel-2)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
a{color:inherit}
.wrap{max-width:1320px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.num{font-variant-numeric:tabular-nums;direction:ltr;unicode-bidi:isolate;display:inline-block}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0;line-height:1.25}

/* header */
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:50}
.strip{background:var(--steel-2);color:var(--steel-fg);font-size:12.5px}
.strip .wrap{display:flex;gap:16px;align-items:center;justify-content:space-between;padding-block:6px;flex-wrap:wrap}
.strip .grp{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.strip button{background:none;border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:2px 12px;color:inherit}
.bar{background:var(--steel);color:var(--steel-fg)}
.bar .wrap{display:flex;gap:14px;align-items:center;padding-block:10px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:10px;background:none;border:0;color:inherit;padding:0}
.logo img{height:44px;width:auto;display:block}
.flogo{height:50px;width:auto;display:block;margin-bottom:12px}
.certs{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}
.cert{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;display:grid;gap:2px}
.cert b{font-family:var(--f-display);font-size:15px;color:var(--wood-strong)}
.cert span{font-size:12.5px;color:var(--muted)}
.legalrows{display:grid;gap:3px;font-size:12.5px;opacity:.85;margin:10px 0 0}
.logo b{font-family:var(--f-display);font-size:21px;letter-spacing:.2px;display:block;line-height:1.1}
.logo small{display:block;font-size:11px;opacity:.75;letter-spacing:.6px}
.search{flex:1 1 380px;display:flex;min-width:0;position:relative;border-radius:var(--r);background:#fff;overflow:visible}
.search select{border:0;background:#e9ecee;color:#1b2228;padding:0 10px;border-start-start-radius:var(--r);border-end-start-radius:var(--r);max-width:140px}
.search input{flex:1;min-width:0;border:0;padding:11px 12px;color:#1b2228;background:#fff;outline-offset:-2px}
.search .go{border:0;background:var(--wood);color:#fff;padding:0 18px;border-start-end-radius:var(--r);border-end-end-radius:var(--r);font-weight:600}
.suggest{position:absolute;top:calc(100% + 4px);inset-inline:0;background:var(--surface);color:var(--fg);border:1px solid var(--line);border-radius:var(--r);box-shadow:0 12px 30px rgba(0,0,0,.18);z-index:70;overflow:hidden}
.suggest button{display:flex;gap:10px;align-items:center;width:100%;text-align:start;background:none;border:0;padding:8px 10px;border-bottom:1px solid var(--line)}
.suggest button:hover,.suggest button:focus-visible{background:var(--surface-2)}
.suggest .th{width:48px;height:36px;border-radius:4px;overflow:hidden;flex:none}
.hbtn{background:none;border:0;color:inherit;display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;padding:4px 6px;border-radius:6px}
.hbtn:hover{background:rgba(255,255,255,.08)}
.hbtn small{font-size:11.5px;opacity:.8}
.hbtn b{font-size:14px}
.cartbtn{flex-direction:row;align-items:center;gap:8px}
.badge-count{background:var(--wood);color:#fff;border-radius:999px;min-width:22px;height:22px;display:inline-grid;place-items:center;font-size:12px;font-weight:700;padding:0 6px}
.nav{background:var(--steel-2);color:var(--steel-fg)}
.nav .wrap{display:flex;gap:4px;align-items:center;overflow-x:auto;padding-block:4px;scrollbar-width:none}
.nav button{background:none;border:0;color:inherit;white-space:nowrap;padding:7px 10px;border-radius:6px;font-size:14px}
.nav button:hover{background:rgba(255,255,255,.08)}
.nav .allbtn{font-weight:700;display:flex;gap:6px;align-items:center}
.mega{position:absolute;inset-inline:0;z-index:90;background:var(--surface);color:var(--fg);border-bottom:1px solid var(--line);box-shadow:0 18px 40px rgba(0,0,0,.18),0 0 0 100vmax rgba(20,12,8,.45);clip-path:inset(0 -100vmax -100vmax -100vmax);max-height:calc(100vh - 150px);max-height:calc(100dvh - 150px);overflow-y:auto;overscroll-behavior:contain}
.mega .wrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;padding-block:22px}
.mega h3{font-size:15px;margin-bottom:10px;color:var(--wood-strong)}
.mega ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:4px 14px}
.mega li button{background:none;border:0;padding:5px 0;text-align:start;width:100%}
.mega li button:hover{color:var(--wood-strong);text-decoration:underline}

/* generic */
main{padding-block:18px 40px;min-height:60vh}
.sec{margin-top:26px}
.sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}
.sec-h h2{font-size:20px}
.link{background:none;border:0;color:var(--wood-strong);font-weight:600;padding:0}
.btn{border:0;border-radius:999px;padding:10px 18px;font-weight:600;background:var(--wood);color:#fff}
.btn:hover{background:var(--wood-strong)}
.btn.alt{background:#e2a568;color:#2a1c15}
.btn.alt:hover{background:#d89452}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--fg)}
.btn.dark{background:var(--steel);color:var(--steel-fg)}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
.muted{color:var(--muted)}
.chip{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line)}
.chip.ok{color:var(--ok)} .chip.warn{color:var(--warn)} .chip.new{background:var(--wood-soft);color:var(--wood-strong);border-color:transparent} .chip.sale{background:var(--sale);color:#fff;border-color:transparent}
.demo{background:var(--wood-soft);color:var(--fg);font-size:13px;border-radius:var(--r);padding:8px 12px;display:flex;gap:8px;align-items:center}

/* hero */
.hero{display:grid;grid-template-columns:1.6fr 1fr;gap:14px}
.hero .main{position:relative;border-radius:12px;overflow:hidden;background:var(--steel);color:var(--steel-fg);min-height:290px;display:grid;grid-template-columns:1.1fr 1fr;align-items:center}
.hero .main .txt{padding:28px;display:grid;gap:12px;align-content:center}
.hero .main h1{font-size:clamp(24px,3.2vw,36px)}
.hero .main p{margin:0;opacity:.85;max-width:44ch}
.hero .main .art{height:100%;min-height:220px}
.hero .main .art svg{width:100%;height:100%;display:block}
.dots{display:flex;gap:6px}
.dots button{width:26px;height:5px;border-radius:3px;border:0;background:rgba(255,255,255,.3);padding:0}
.dots button.on{background:#e2a568}
.hero .side{display:grid;gap:14px}
.promo{border-radius:12px;padding:18px;display:grid;gap:6px;align-content:center;border:1px solid var(--line);background:var(--surface)}
.promo h3{font-size:17px}
.promo.inst{background:var(--wood-soft);border-color:transparent}
.trust{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}
.trust div{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px;display:flex;gap:10px;align-items:center;font-size:13.5px}
.trust svg{flex:none;width:28px;height:28px;color:var(--wood)}
.trust b{display:block;font-size:14px}

/* category tiles */
.cats{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
.cat{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:8px;display:grid;gap:6px;text-align:center;font-weight:600;font-size:13.5px}
.cat:hover{border-color:var(--wood)}
.cat .im{border-radius:6px;overflow:hidden;aspect-ratio:4/3;max-width:100%}
.cat .im svg{display:block;width:100%;height:100%}

/* product cards */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(200px,220px);gap:12px;overflow-x:auto;padding-bottom:6px;scroll-snap-type:x mandatory}
.row>*{scroll-snap-align:start}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);display:flex;flex-direction:column;overflow:hidden;position:relative}
.card:hover{box-shadow:0 6px 20px rgba(20,38,54,.12)}
.card .im{aspect-ratio:4/3;background:var(--surface-2);border:0;padding:0;display:block;width:100%}
.card .im svg{width:100%;height:100%;display:block}
.card .bd{padding:10px 12px 12px;display:flex;flex-direction:column;gap:6px;flex:1}
.card .nm{background:none;border:0;padding:0;text-align:start;font-weight:600;font-size:14.5px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.8em}
.card .nm:hover{color:var(--wood-strong)}
.card .sku{font-size:11.5px;color:var(--muted)}
.price{font-weight:700;font-size:18px}
.price small{font-size:12px;font-weight:500;color:var(--muted)}
.was{color:var(--muted);text-decoration:line-through;font-size:12.5px;margin-inline-start:6px}
.card .tags{display:flex;gap:4px;flex-wrap:wrap}
.card .act{margin-top:auto;display:grid}
.card .act .btn{padding:8px 12px;font-size:14px}
.wishbtn{position:absolute;top:8px;inset-inline-end:8px;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center}
.wishbtn svg{width:18px;height:18px}
.wishbtn.on{color:var(--sale)}
.corner{position:absolute;top:8px;inset-inline-start:8px;display:flex;gap:4px}
.inst-line{font-size:12px;color:var(--muted)}

/* listing */
.crumbs{font-size:13px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.crumbs button{background:none;border:0;padding:0;color:var(--wood-strong)}
.listing{display:grid;grid-template-columns:250px minmax(0,1fr);gap:18px;align-items:start}
.filters{padding:14px;display:grid;gap:16px;position:sticky;top:150px}
.filters h4{margin:0 0 8px;font-size:14px}
.filters label{display:flex;gap:8px;align-items:center;font-size:14px;padding:3px 0}
.filters input[type=range]{width:100%;accent-color:var(--wood)}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.toolbar select{border:1px solid var(--line);border-radius:6px;padding:6px 8px;background:var(--surface)}
.empty{padding:40px;text-align:center}

/* product page */
.pdp{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr) 300px;gap:22px;align-items:start}
.gal .big{border-radius:var(--r);overflow:hidden;border:1px solid var(--line);aspect-ratio:4/3;background:var(--surface-2)}
.gal .big svg{width:100%;height:100%;display:block}
.gal .thumbs{display:flex;gap:8px;margin-top:8px}
.gal .thumbs button{width:72px;aspect-ratio:4/3;padding:0;border:2px solid var(--line);border-radius:6px;overflow:hidden;background:none}
.gal .thumbs button.on{border-color:var(--wood)}
.gal .thumbs svg{width:100%;height:100%;display:block}
.info{display:grid;gap:12px}
.info h1{font-size:24px}
.opt h4{margin:0 0 6px;font-size:13.5px}
.opt .vals{display:flex;gap:6px;flex-wrap:wrap}
.opt .vals button{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:6px 12px;font-size:13.5px}
.opt .vals button.on{border-color:var(--wood);box-shadow:inset 0 0 0 1px var(--wood);background:var(--wood-soft)}
.cfg{padding:14px;display:grid;gap:10px;background:var(--surface-2)}
.cfg .f{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
.field{display:grid;gap:4px;font-size:13px}
.field input,.field select,.field textarea{border:1px solid var(--line);border-radius:6px;padding:9px 10px;background:var(--surface);width:100%}
.buybox{padding:16px;display:grid;gap:10px;position:sticky;top:150px}
.buybox .price{font-size:26px}
.qty{display:flex;align-items:center;border:1px solid var(--line);border-radius:999px;width:max-content;overflow:hidden}
.qty button{border:0;background:var(--surface-2);width:36px;height:36px;font-size:18px}
.qty input{width:56px;text-align:center;border:0;background:var(--surface);height:36px}
.specs{width:100%;border-collapse:collapse;font-size:14px}
.specs th,.specs td{padding:9px 12px;border-bottom:1px solid var(--line);text-align:start;vertical-align:top}
.specs th{width:38%;background:var(--surface-2);font-weight:600}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:12px;overflow-x:auto}
.tabs button{border:0;background:none;padding:10px 14px;font-weight:600;border-bottom:3px solid transparent;white-space:nowrap}
.tabs button.on{border-color:var(--wood);color:var(--wood-strong)}
.fbt{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:14px}
.fbt .it{width:120px;text-align:center;font-size:12.5px}
.fbt .it .im{border-radius:6px;overflow:hidden;aspect-ratio:4/3;border:1px solid var(--line)}
.fbt .it svg{display:block;width:100%;height:100%}
.plus{font-size:22px;color:var(--muted)}

/* drawer & modal */
.scrim{position:fixed;inset:0;background:rgba(10,18,25,.5);z-index:80}
.drawer{position:fixed;top:0;bottom:0;inset-inline-end:0;width:min(420px,100%);background:var(--surface);z-index:90;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);box-shadow:0 0 40px rgba(0,0,0,.3)}
.drawer .hd{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.drawer .ls{flex:1;overflow:auto;padding:8px 16px;display:grid;gap:10px;align-content:start}
.drawer .ft{border-top:1px solid var(--line);padding:14px 16px;display:grid;gap:8px}
.xbtn{border:0;background:var(--surface-2);width:34px;height:34px;border-radius:50%;font-size:18px}
.line{display:grid;grid-template-columns:72px minmax(0,1fr);gap:10px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.line .im{border-radius:6px;overflow:hidden;aspect-ratio:4/3}
.line .im svg{display:block;width:100%;height:100%}
.line .meta{font-size:12.5px;color:var(--muted)}
.line .ctl{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-top:4px;flex-wrap:wrap}
.line .qty button{width:28px;height:28px;font-size:15px}
.line .qty input{width:42px;height:28px}
.sum{display:grid;gap:6px;font-size:14px}
.sum div{display:flex;justify-content:space-between;gap:10px}
.sum .tot{font-size:18px;font-weight:700;border-top:1px solid var(--line);padding-top:8px}
.modal{position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:16px}
.modal .box{background:var(--surface);border-radius:12px;width:min(560px,100%);max-height:90vh;overflow:auto;padding:20px;display:grid;gap:12px;position:relative}
.toast{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));inset-inline-start:50%;transform:translateX(-50%);background:var(--steel);color:var(--steel-fg);padding:10px 18px;border-radius:999px;z-index:100;font-size:14px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
[dir=rtl] .toast{transform:translateX(50%)}

/* checkout */
.co{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:20px;align-items:start}
.step{padding:16px;display:grid;gap:12px}
.step h3{font-size:17px;display:flex;gap:10px;align-items:center}
.step h3 .n{width:26px;height:26px;border-radius:50%;background:var(--steel);color:var(--steel-fg);display:inline-grid;place-items:center;font-size:13px}
.f2{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.opts{display:grid;gap:8px}
.optc{display:flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:var(--r);padding:10px 12px;background:var(--surface)}
.optc:has(input:checked){border-color:var(--wood);background:var(--wood-soft)}
.optc.dis{opacity:.5}
.optc .grow{flex:1;min-width:0}
.optc .sub{font-size:12.5px;color:var(--muted)}
.pm{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
.pmark{font-weight:700;font-size:12px;padding:3px 8px;border-radius:4px;white-space:nowrap;font-family:var(--f-display)}
.pmark.mada{background:#fff;color:#259bd6;border:1px solid #cfd8dc}
.pmark.visa{background:#1a1f71;color:#fff}
.pmark.mc{background:#fff;color:#eb001b;border:1px solid #cfd8dc}
.pmark.apple{background:#000;color:#fff}
.pmark.stc{background:#4f008c;color:#fff}
.pmark.tabby{background:#3bffc1;color:#111}
.pmark.tamara{background:linear-gradient(90deg,#f6c7a8,#d9b8f3);color:#111}
.pmark.bank,.pmark.cod,.pmark.sadad{background:var(--surface-2);color:var(--fg);border:1px solid var(--line)}
.paystrip{display:flex;gap:6px;flex-wrap:wrap}

/* footer */
footer{background:var(--steel-2);color:var(--steel-fg);font-size:13.5px}
footer .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;padding-block:28px}
footer h4{margin:0 0 10px;font-family:var(--f-display);font-size:15px}
footer ul{list-style:none;padding:0;margin:0;display:grid;gap:6px}
footer button{background:none;border:0;padding:0;color:inherit;opacity:.85;text-align:start}
footer .legal{border-top:1px solid rgba(255,255,255,.12);padding-block:14px;display:flex;gap:12px;justify-content:space-between;flex-wrap:wrap;opacity:.8;font-size:12.5px}
.projects{display:flex;gap:8px;flex-wrap:wrap}
.projects span{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:13px}
.why{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.why .panel{padding:16px}
.why h3{font-size:15px;margin-bottom:4px}
.success{max-width:720px;margin-inline:auto;padding:24px;display:grid;gap:14px}
.success .ok{color:var(--ok)}

